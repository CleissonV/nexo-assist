# Sem chave: demonstração determinística, identificada na interface.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Alternativa com faixa gratuita: chave do Google AI Studio (sem ativar billing).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_GATEWAY_ENABLED=false
AI_GATEWAY_MODEL=openai/gpt-4.1-mini
# Na Vercel, AI Gateway usa OIDC; localmente pode usar AI_GATEWAY_API_KEY.
AI_GATEWAY_API_KEY=
# Local: arquivo persistente. Vercel: URL libsql/Turso e token obrigatórios.
DATABASE_URL=file:nexo.db
DATABASE_AUTH_TOKEN=
# Senha do console (obrigatória em produção)
ANALYST_PASSWORD=
